# PostgreSQL database configuration
# Copy this file to .env and fill in your own values.
DJANGO_SECRET_KEY=change-me-in-local-env
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True
DB_NAME=ong_back
DB_USER=postgres
