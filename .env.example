# PostgreSQL database configuration
# Copy this file to .env and fill in your own values.
DB_NAME=ong_back
DB_USER=postgres
DB_PASSWORD=secretpassword
DB_HOST=localhost
DB_PORT=5432
DJANGO_SECRET_KEY=django-insecure-very-secret-key
DATABASE_URL=postgresql://postgres:secretpassword@localhost:5432/ong_back
DEBUG=TRUE
