                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Samira Test\",\n  \"email\": \"samira@example.test\",\n  \"password\": \"StrongPassword123!\",\n  \"password_confirmation\": \"StrongPassword123!\",\n  \"locale\": \"fr\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register/candidate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register",
                "candidate"
              ]
            }
          }
        }
      ]
