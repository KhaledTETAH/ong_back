                "{{offerSlug}}",
                "applications"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Skills sponsorship",
      "item": [
        {
          "name": "Submit mission",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.tracking_uuid) pm.collectionVariables.set('trackingUuid', json.data.tracking_uuid);",
                  "if (json.debug_verification_token) pm.collectionVariables.set('trackingToken', json.debug_verification_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contact_email\": \"mecenat@entreprise.test\",\n  \"company_name\": \"Entreprise Solidaire\",\n  \"company_legal_id\": \"RC-2026-001\",\n  \"country_code\": \"FR\",\n  \"title\": \"Audit de cybersécurité solidaire\",\n  \"description\": \"Audit et plan de remédiation.\",\n  \"man_days\": 12,\n  \"visibility\": \"verified_organizations\",\n  \"cause_ids\": [\n    2\n  ],\n  \"consent\": true,\n  \"website\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sponsorship-missions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sponsorship-missions"
              ]
            }
          }
        },
        {
          "name": "Verify mission",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{trackingToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sponsorship-missions/{{trackingUuid}}/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sponsorship-missions",
                "{{trackingUuid}}",
                "verify"
              ]
            }
          }
        },
        {
          "name": "Track mission",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sponsorship-missions/{{trackingUuid}}?token={{trackingToken}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sponsorship-missions",
                "{{trackingUuid}}"
              ],
              "query": [
                {
                  "key": "token",
                  "value": "{{trackingToken}}"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}