              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "home"
              ]
            }
          }
        },
        {
          "name": "Search offers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/offers?q=education&country=DZ&sort=relevance",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "offers"
              ],
              "query": [
                {
