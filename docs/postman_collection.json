              ],
              "path": [
                "offers",
                "{{offerSlug}}",
                "saved"
              ]
            }
          }
        },
        {
          "name": "Apply",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cover_letter\": \"Je souhaite contribuer à cette mission.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/offers/{{offerSlug}}/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
