    {
      "name": "Candidate actions",
      "item": [
        {
          "name": "Save offer",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/offers/{{offerSlug}}/saved",
              "host": [
